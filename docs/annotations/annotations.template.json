    {
      "annotation_id": "attention-v7-04",
      "paper_id": "arxiv:1706.03762",
      "document_sha256": "bdfaa68d8984f0dc02beaca527b76f207d99b666d31d1da728ee0728182df697",
      "source_version": "arXiv:1706.03762v7 [cs.CL], 2 Aug 2023",
      "source_pdf": "data/live/document.pdf",
      "field": "method",
      "experiment_or_model": "Transformer encoder",
      "dataset": null,
      "metric": "layers",
      "value": "6",
      "unit": "layers",
      "setting": "Encoder stack",
      "exact_evidence_quote": "Encoder:\nThe encoder is composed of a stack of N = 6 identical layers. Each layer has two\nsub-layers. The first is a multi-head self-attention mechanism, and the second is a simple, position-\nwise fully connected feed-forward network. We employ a residual connection [11] around each of\nthe two sub-layers, followed by layer normalization [1]. That is, the output of each sub-layer is\nLayerNorm(x + Sublayer(x)), where Sublayer(x) is the function implemented by the sub-layer\nitself. To facilitate these residual connections, all sub-layers in the model, as well as the embedding\nlayers, produce outputs of dimension dmodel = 512.",
      "page": "p3",
      "section": "abstract",
      "chunk_id": "arxiv:1706.03762:35#0",
      "block_id": "arxiv:1706.03762:35",
      "table_id": null,
